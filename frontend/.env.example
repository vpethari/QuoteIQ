# Leave empty (or omit) in local Vite development.
# The dev server proxies same-origin /api to http://127.0.0.1:8000.
# Do not set this to http://localhost:8000 or http://127.0.0.1:8000 while using npm run dev.
VITE_API_BASE_URL=

# Optional: override the Vite proxy target (default http://127.0.0.1:8000)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
