# PostgreSQL (optional; not required for local quote matching from Excel)
POSTGRES_USER=quoteiq
POSTGRES_PASSWORD=quoteiq_dev
POSTGRES_DB=quoteiq
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Runtime catalog source: postgresql (Azure) or excel (local tests/import only)
CATALOG_SOURCE=postgresql
CATALOG_TABLE=productmaster
CATALOG_ID_COLUMN=id
CATALOG_PRODUCTCODE_COLUMN=Productcode
CATALOG_NAME_COLUMN=name
CATALOG_DESCRIPTION_COLUMN=description
CATALOG_DESCRIPTION2_COLUMN=description2
CATALOG_RETRIEVAL_LIMIT=100
CATALOG_SEARCH_TEXT_LIMIT=30

# Used only when CATALOG_SOURCE=excel
CATALOG_EXCEL_PATH=data/Atkorepartsfile.xlsx

# Deterministic matching (used when AI is off)
AI_MATCHING_ENABLED=false
AI_CONFIDENT_THRESHOLD=90
AI_REVIEW_THRESHOLD=50
AI_MAX_CANDIDATES=5

# Azure OpenAI — optional. Leave blank for local deterministic matching.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21

QUOTE_UPLOAD_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173

# Match-decision confidence (field weights must sum to 1.0)
MATCH_HIGH_CONFIDENCE_MIN=90
MATCH_MIN_THRESHOLD=25
MATCH_MIN_SCORE_GAP=8
MATCH_AMBIGUOUS_CONFIDENCE_CAP=86
MATCH_NUMERIC_CONFLICT_CAP=40
MATCH_PARTIAL_MAX_CONFIDENCE=78
MATCH_CONFIDENCE_WEIGHT_PRODUCTCODE=0.50
MATCH_CONFIDENCE_WEIGHT_NAME=0.15
MATCH_CONFIDENCE_WEIGHT_DESCRIPTION=0.20
MATCH_CONFIDENCE_WEIGHT_DESCRIPTION2=0.05
MATCH_CONFIDENCE_WEIGHT_NUMERIC=0.10
